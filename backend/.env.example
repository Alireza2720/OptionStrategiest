# ============================================================
# OptionStrategist — Environment Variables (Example)
# ============================================================

# ---- MongoDB (shared with OptionHunter) ----
MONGODB_URI=mongodb://optionhunter:YOUR_PASSWORD@127.0.0.1:27017/trading_bot?authSource=trading_bot

# ---- Server ----
PORT=3001

# ---- Telegram / Bale ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://tapi.bale.ai

# ---- CORS ----
ALLOWED_ORIGIN=https://optionstrategist.ir,https://www.optionstrategist.ir

# ---- Option Chain Source (Phase 2) ----
# Primary: OptionHunter backend proxy (uses collector + TSETMC).
# Fallback: direct optionschool24 (used only if proxy fails).
OPTIONS_CHAIN_PROXY_URL=http://127.0.0.1:3000/api/options-chain

# ---- API auth (for OptionHunter backend, if ADMIN_TOKEN set) ----
OPTIONS_CHAIN_PROXY_TOKEN=